run_browser_crud_categories() {
  verify_installed >/dev/null
  verify_fixtures >/dev/null
  local run_id="${FDSHOP_CATEGORIES_CRUD_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-categories-crud-$RANDOM}"
  [[ "$run_id" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'Invalid categories CRUD run id.\n' >&2; return 1; }
  local container_output="/workspace/artifacts/$run_id"
  local host_output="$REPO_ROOT/.docker/test-results/playwright/$run_id"
  mkdir -p "$host_output"
  compose build browser
  if ! compose run --rm --no-deps \
    --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" \
    browser npx playwright test tests/categories-crud.spec.js \
      --grep 'category validation, create, apply, save-close, status and protection'; then
    printf 'Category CRUD artifacts: %s\nFDShop category CRUD suite: FAIL\n' "$host_output" >&2
    return 1
  fi

  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_categories WHERE category_name='E2E-CRUD-CATEGORY-REFERENCE';")" == "1" ]]
  [[ "$(sql "SELECT is_active FROM ${JOOMLA_DB_PREFIX}fdshop_categories WHERE category_name='E2E-CRUD-CATEGORY-REFERENCE';")" == "0" ]]
  [[ "$(sql "SELECT description FROM ${JOOMLA_DB_PREFIX}fdshop_categories WHERE category_name='E2E-CRUD-CATEGORY-REFERENCE';")" == "CRUD category description after save-close" ]]

  if ! compose run --rm --no-deps \
    --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" \
    browser npx playwright test tests/categories-crud.spec.js --grep 'category cleanup'; then
    printf 'Category CRUD artifacts: %s\nFDShop category CRUD cleanup: FAIL\n' "$host_output" >&2
    return 1
  fi

  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_categories WHERE category_name='E2E-CRUD-CATEGORY-REFERENCE';")" == "0" ]]
  verify_fixtures >/dev/null
  printf 'Category CRUD artifacts: %s\nFDShop category CRUD suite: PASS (database state and cleanup verified)\n' "$host_output"
}

run_browser_crud_products() {
  verify_installed >/dev/null
  verify_fixtures >/dev/null
  local run_id="${FDSHOP_PRODUCTS_CRUD_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-products-crud-$RANDOM}"
  [[ "$run_id" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'Invalid products CRUD run id.\n' >&2; return 1; }
  local container_output="/workspace/artifacts/$run_id"
  local host_output="$REPO_ROOT/.docker/test-results/playwright/$run_id"
  local fixture_hash_before media_count_before image_count_before
  mkdir -p "$host_output"
  fixture_hash_before="$(compose exec -T joomla sha256sum /var/www/html/images/FDShop/products/e2e-fixture-product.svg | awk '{print $1}')"
  media_count_before="$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_media;")"
  image_count_before="$(compose exec -T joomla find /var/www/html/images/FDShop/products -type f | wc -l)"
  compose build browser

  if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" browser \
    npx playwright test tests/products-crud.spec.js --grep 'product invalid save'; then
    printf 'Product CRUD artifacts: %s\nFDShop product CRUD suite: FAIL\n' "$host_output" >&2
    return 1
  fi

  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_products WHERE product_name='E2E-CRUD-PRODUCT-REFERENCE';")" == "1" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_products p JOIN ${JOOMLA_DB_PREFIX}fdshop_products_details d ON d.product_id=p.id WHERE p.product_name='E2E-CRUD-PRODUCT-REFERENCE' AND p.manufacturer_id=900001 AND p.sale_price=32.5000 AND p.discount_price=27.5000 AND p.discount_active=1 AND p.in_stock='Verfügbar' AND p.unit_type='Display' AND p.meta_title='CRUD meta title after save-close' AND d.sku='E2E-CRUD-PRODUCT-REFERENCE' AND d.stock_quantity=3 AND d.low_stock=4 AND d.reserved_quantity=2 AND d.unit_quantity=6 AND d.unit_discount_type='percent' AND d.unit_discount_value=5.0000;")" == "1" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_product_category_map pcm JOIN ${JOOMLA_DB_PREFIX}fdshop_products p ON p.id=pcm.product_id WHERE p.product_name='E2E-CRUD-PRODUCT-REFERENCE';")" == "2" ]]
  [[ "$(sql "SELECT COUNT(DISTINCT pcm.category_id) FROM ${JOOMLA_DB_PREFIX}fdshop_product_category_map pcm JOIN ${JOOMLA_DB_PREFIX}fdshop_products p ON p.id=pcm.product_id WHERE p.product_name='E2E-CRUD-PRODUCT-REFERENCE';")" == "2" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_product_buyer_group_map pbgm JOIN ${JOOMLA_DB_PREFIX}fdshop_products p ON p.id=pbgm.product_id WHERE p.product_name='E2E-CRUD-PRODUCT-REFERENCE';")" == "2" ]]
  [[ "$(sql "SELECT COUNT(DISTINCT pbgm.buyer_group_id) FROM ${JOOMLA_DB_PREFIX}fdshop_product_buyer_group_map pbgm JOIN ${JOOMLA_DB_PREFIX}fdshop_products p ON p.id=pbgm.product_id WHERE p.product_name='E2E-CRUD-PRODUCT-REFERENCE';")" == "2" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_media m JOIN ${JOOMLA_DB_PREFIX}fdshop_products p ON p.id=m.product_id WHERE p.product_name='E2E-CRUD-PRODUCT-REFERENCE' AND m.media_type='image';")" == "1" ]]
  local media_paths standard_meta small_meta mobile_meta invoice_meta
  media_paths="$(sql "SELECT CONCAT_WS('|',m.path_standard,m.path_small,m.path_mobile,m.path_invoice) FROM ${JOOMLA_DB_PREFIX}fdshop_media m JOIN ${JOOMLA_DB_PREFIX}fdshop_products p ON p.id=m.product_id WHERE p.product_name='E2E-CRUD-PRODUCT-REFERENCE' AND m.media_type='image' LIMIT 1;")"
  IFS='|' read -r standard_path small_path mobile_path invoice_path <<<"$media_paths"
  [[ "$standard_path" == *.webp && "$small_path" == *.webp && "$mobile_path" == *.webp && "$invoice_path" == *.png ]]
  standard_meta="$(compose exec -T joomla php -r '$i=getimagesize("/var/www/html/'"$standard_path"'"); echo $i[0]."|".$i[1]."|".$i["mime"];')"
  small_meta="$(compose exec -T joomla php -r '$i=getimagesize("/var/www/html/'"$small_path"'"); echo $i[0]."|".$i[1]."|".$i["mime"];')"
  mobile_meta="$(compose exec -T joomla php -r '$i=getimagesize("/var/www/html/'"$mobile_path"'"); echo $i[0]."|".$i[1]."|".$i["mime"];')"
  invoice_meta="$(compose exec -T joomla php -r '$i=getimagesize("/var/www/html/'"$invoice_path"'"); echo $i[0]."|".$i[1]."|".$i["mime"];')"
  IFS='|' read -r standard_width standard_height standard_mime <<<"$standard_meta"
  IFS='|' read -r small_width small_height small_mime <<<"$small_meta"
  IFS='|' read -r mobile_width mobile_height mobile_mime <<<"$mobile_meta"
  IFS='|' read -r invoice_width invoice_height invoice_mime <<<"$invoice_meta"
  [[ "$standard_mime" == image/webp && "$small_mime" == image/webp && "$mobile_mime" == image/webp && "$invoice_mime" == image/png ]]
  (( standard_width <= 550 && standard_height <= 485 && standard_width * standard_height <= 170000 ))
  (( small_width <= 200 && small_height <= 176 && small_width * small_height <= 22480 ))
  (( mobile_width <= 250 && mobile_height <= 220 && mobile_width * mobile_height <= 35124 ))
  [[ "$invoice_width|$invoice_height" == "$small_width|$small_height" ]]

  if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" browser \
    npx playwright test tests/products-crud.spec.js --grep 'fixture image survives'; then
    printf 'Product CRUD artifacts: %s\nFDShop product fixture-image/protection checks: FAIL\n' "$host_output" >&2
    return 1
  fi
  [[ "$(sql "SELECT CONCAT(is_deleted, '|', description) FROM ${JOOMLA_DB_PREFIX}fdshop_products WHERE id=900100;")" == "0|Aktiv mit Bestand" ]]
  [[ "$(sql "SELECT CONCAT(is_deleted, '|', description) FROM ${JOOMLA_DB_PREFIX}fdshop_products WHERE id=900103;")" == "0|Mit synthetischem Bild" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_media WHERE id=900340 AND product_id=900103;")" == "1" ]]
  [[ "$(compose exec -T joomla sha256sum /var/www/html/images/FDShop/products/e2e-fixture-product.svg | awk '{print $1}')" == "$fixture_hash_before" ]]

  if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" browser \
    npx playwright test tests/products-crud.spec.js --grep 'product trash'; then
    printf 'Product CRUD artifacts: %s\nFDShop product CRUD cleanup: FAIL\n' "$host_output" >&2
    return 1
  fi
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_products WHERE product_name='E2E-CRUD-PRODUCT-REFERENCE';")" == "0" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_products_details d LEFT JOIN ${JOOMLA_DB_PREFIX}fdshop_products p ON p.id=d.product_id WHERE p.id IS NULL;")" == "0" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_media;")" == "$media_count_before" ]]
  [[ "$(compose exec -T joomla find /var/www/html/images/FDShop/products -type f | wc -l)" == "$image_count_before" ]]
  verify_fixtures >/dev/null
  printf 'Product CRUD artifacts: %s\nFDShop product CRUD suite: PASS (database, media and cleanup verified)\n' "$host_output"
}

run_browser_crud_coupons() {
  verify_installed >/dev/null
  verify_fixtures >/dev/null
  local run_id="${FDSHOP_COUPONS_CRUD_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-coupons-crud-$RANDOM}"
  [[ "$run_id" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'Invalid coupons CRUD run id.\n' >&2; return 1; }
  local container_output="/workspace/artifacts/$run_id"
  local host_output="$REPO_ROOT/.docker/test-results/playwright/$run_id"
  local coupon_id
  mkdir -p "$host_output"
  compose build browser

  if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" browser \
    npx playwright test tests/coupons-crud.spec.js --grep 'coupon invalid save'; then
    printf 'Coupon CRUD artifacts: %s\nFDShop coupon CRUD suite: FAIL\n' "$host_output" >&2
    return 1
  fi

  coupon_id="$(sql "SELECT id FROM ${JOOMLA_DB_PREFIX}fdshop_coupons WHERE coupon_code='E2E-CRUD-COUPON-REFERENCE';")"
  [[ "$coupon_id" =~ ^[0-9]+$ ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupons WHERE id=${coupon_id} AND coupon_name='E2E-CRUD-COUPON-UPDATED' AND discount_type='fixed' AND discount_value=8.7500 AND minimum_order_total=55.5000 AND usage_limit_total=30 AND usage_limit_per_user=3 AND valid_from='2027-01-01 00:00:00' AND valid_to='2032-12-31 23:59:59' AND published=1;")" == "1" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_product_map WHERE coupon_id=${coupon_id};")" == "2" ]]
  [[ "$(sql "SELECT COUNT(DISTINCT product_id) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_product_map WHERE coupon_id=${coupon_id};")" == "2" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_category_map WHERE coupon_id=${coupon_id};")" == "2" ]]
  [[ "$(sql "SELECT COUNT(DISTINCT category_id) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_category_map WHERE coupon_id=${coupon_id};")" == "2" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_buyer_group_map WHERE coupon_id=${coupon_id};")" == "2" ]]
  [[ "$(sql "SELECT COUNT(DISTINCT buyer_group_id) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_buyer_group_map WHERE coupon_id=${coupon_id};")" == "2" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_user_map WHERE coupon_id=${coupon_id};")" == "1" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_usage WHERE coupon_id=${coupon_id};")" == "0" ]]

  if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" browser \
    npx playwright test tests/coupons-crud.spec.js --grep 'coupon direct delete'; then
    printf 'Coupon CRUD artifacts: %s\nFDShop coupon CRUD cleanup: FAIL\n' "$host_output" >&2
    return 1
  fi

  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupons WHERE id=${coupon_id};")" == "0" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_product_map WHERE coupon_id=${coupon_id};")" == "0" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_category_map WHERE coupon_id=${coupon_id};")" == "0" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_buyer_group_map WHERE coupon_id=${coupon_id};")" == "0" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_user_map WHERE coupon_id=${coupon_id};")" == "0" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_coupon_usage WHERE coupon_id=${coupon_id};")" == "0" ]]
  verify_fixtures >/dev/null
  printf 'Coupon CRUD artifacts: %s\nFDShop coupon CRUD suite: PASS (database, mappings, usage and cleanup verified)\n' "$host_output"
}

run_browser_crud_bundles() {
  verify_installed >/dev/null
  verify_fixtures >/dev/null
  local run_id="${FDSHOP_BUNDLES_CRUD_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-bundles-crud-$RANDOM}"
  [[ "$run_id" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'Invalid bundles CRUD run id.\n' >&2; return 1; }
  local container_output="/workspace/artifacts/$run_id"
  local host_output="$REPO_ROOT/.docker/test-results/playwright/$run_id"
  local bundle_id bundle_number multi_bundle_id
  local items_before rules_before main_after items_after rules_after
  mkdir -p "$host_output"
  compose build browser

  if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" browser \
    npx playwright test tests/bundles-crud.spec.js --grep 'bundle invalid save'; then
    printf 'Bundle CRUD artifacts: %s\nFDShop bundle CRUD suite: FAIL\n' "$host_output" >&2
    return 1
  fi
  bundle_id="$(sql "SELECT id FROM ${JOOMLA_DB_PREFIX}fdshop_bundles WHERE bundle_name='E2E-CRUD-BUNDLE-UPDATED';")"
  bundle_number="$(sql "SELECT bundle_number FROM ${JOOMLA_DB_PREFIX}fdshop_bundles WHERE id=${bundle_id};")"
  multi_bundle_id="$(sql "SELECT id FROM ${JOOMLA_DB_PREFIX}fdshop_bundles WHERE bundle_name='E2E-CRUD-BUNDLE-MULTI';")"
  [[ "$bundle_id" =~ ^[0-9]+$ && "$bundle_number" =~ ^BUNDLE-[0-9]+$ ]] || return 1
  [[ "$multi_bundle_id" =~ ^[0-9]+$ ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_bundles WHERE id=${bundle_id} AND bundle_number='${bundle_number}' AND description='CRUD bundle after apply' AND is_active=1;")" == "1" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_bundle_items WHERE bundle_id=${bundle_id} AND product_id=900100 AND ordering=1;")" == "1" ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_bundle_discount_rules WHERE bundle_id=${bundle_id} AND min_quantity=4 AND discount_percent=12.5000;")" == "1" ]]
  items_before="$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_bundle_items WHERE bundle_id IN (${bundle_id},${multi_bundle_id});")"
  rules_before="$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_bundle_discount_rules WHERE bundle_id IN (${bundle_id},${multi_bundle_id});")"
  [[ "$items_before" == "2" ]]
  [[ "$rules_before" == "2" ]]
  [[ "$(sql "SELECT ribbon_bundle FROM ${JOOMLA_DB_PREFIX}fdshop_products WHERE id=900103;")" == "1" ]] || return 1
  printf 'Bundle CRUD delete: ids=%s,%s; child rows before delete: items=%s, rules=%s\n' \
    "$bundle_id" "$multi_bundle_id" "$items_before" "$rules_before"

  if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" browser \
    npx playwright test tests/bundles-crud.spec.js --grep 'bundle direct delete'; then
    printf 'Bundle CRUD artifacts: %s\nFDShop bundle CRUD delete: FAIL\n' "$host_output" >&2
    return 1
  fi
  main_after="$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_bundles WHERE id IN (${bundle_id},${multi_bundle_id});")"
  items_after="$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_bundle_items WHERE bundle_id IN (${bundle_id},${multi_bundle_id});")"
  rules_after="$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_bundle_discount_rules WHERE bundle_id IN (${bundle_id},${multi_bundle_id});")"
  printf 'Bundle CRUD delete: parent rows after delete=%s; child rows after delete: items=%s, rules=%s\n' \
    "$main_after" "$items_after" "$rules_after"
  [[ "$main_after" == "0" ]]
  [[ "$items_after" == "0" ]]
  [[ "$rules_after" == "0" ]]
  [[ "$(sql "SELECT ribbon_bundle FROM ${JOOMLA_DB_PREFIX}fdshop_products WHERE id=900103;")" == "0" ]] || return 1
  verify_fixtures >/dev/null
  printf 'Bundle CRUD artifacts: %s\nFDShop bundle CRUD suite: PASS (database and cleanup verified)\n' "$host_output"
}

