  run_browser_readonly
}
test_reset_environment() {
  compose down --volumes --remove-orphans
  compose up --detach --build
  wait_healthy
  install_fdshop
  load_fixtures
}
run_test_step() {
  local label="$1"; shift
  printf '\n==> %s\n' "$label"
  if "$@"; then printf '<== %s: PASS\n' "$label"; else printf '<== %s: FAIL\n' "$label" >&2; return 1; fi
}
crud_runner() {
  case "$1" in
    manufacturers) run_browser_crud_manufacturers ;;
    categories) run_browser_crud_categories ;;
    configuration) run_browser_crud_configuration ;;
    products) run_browser_crud_products ;;
    coupons) run_browser_crud_coupons ;;
    bundles) run_browser_crud_bundles ;;
    orders) run_browser_crud_orders ;;
    frontend-category) run_browser_frontend_category ;;
    frontend-cart) run_browser_frontend_cart ;;
    purchase) run_browser_purchase ;;
    *) printf 'Unknown standard test area: %s\nValid areas: manufacturers categories configuration products coupons bundles orders frontend-category frontend-cart purchase\n' "$1" >&2; return 2 ;;
  esac
}
valid_crud_area() {
  case "$1" in manufacturers|categories|configuration|products|coupons|bundles|orders|frontend-category|frontend-cart|purchase) return 0 ;; esac
  printf 'Unknown standard test area: %s\nValid areas: manufacturers categories configuration products coupons bundles orders frontend-category frontend-cart purchase\n' "$1" >&2
  return 2
}
verify_package_scope() {
  build_package
  local entries
  entries="$(unzip -Z1 "$PACKAGE_PATH")"
  if grep -Eq '(^|/)(tests?|node_modules|playwright|\.docker)(/|$)|(^|/)(alt_|alt2_)' <<<"$entries"; then
    printf 'Package contains forbidden test, tooling, artifact or legacy files.\n' >&2; return 1
  fi
  printf 'FDShop package scope: PASS (no tests, Node, Playwright, artifacts or alt files)\n'
}
test_quick() {
  run_test_step 'Quick smoke' run_smoke
  printf '\nFDShop quick test suite: PASS\n'
}
test_standard() {
  local area="${1:-}"
  local area_label="$area CRUD"
  [[ "$area" == frontend-category ]] && area_label='Frontend category suite'
  [[ "$area" == frontend-cart ]] && area_label='Frontend cart suite'
  [[ "$area" == purchase ]] && area_label='Purchase action suite'
  valid_crud_area "$area" || return $?
  run_test_step 'Test reset' test_reset_environment
  run_test_step 'Smoke' run_smoke
  run_test_step 'Browser foundation' run_browser
  run_test_step 'Read-only regression' run_browser_readonly
  if ! run_test_step "$area_label" crud_runner "$area"; then
    printf 'Restoring fixture sandbox after failed %s suite; diagnostic artifacts are retained.\n' "$area" >&2
    test_reset_environment || true
    return 1
  fi
  run_test_step 'Final test reset' test_reset_environment
  run_test_step 'Fixture integrity' verify_fixtures
  run_test_step 'Log check' assert_clean_logs
  printf '\nFDShop standard test suite (%s): PASS\n' "$area"
}
test_full() {
  local areas=(manufacturers categories configuration products coupons bundles orders frontend-category frontend-cart purchase)
  local total=30 step=0 area
  full_step() { step=$((step + 1)); run_test_step "[$step/$total] $1" "${@:2}"; }
  full_step 'Initial test reset' test_reset_environment
  full_step 'Smoke' run_smoke
  full_step 'Browser foundation' run_browser
  full_step 'Read-only regression' run_browser_readonly
  for area in "${areas[@]}"; do
    local area_label="$area CRUD"
    [[ "$area" == frontend-category ]] && area_label='Frontend category suite'
    [[ "$area" == frontend-cart ]] && area_label='Frontend cart suite'
    [[ "$area" == purchase ]] && area_label='Purchase action suite'
    full_step "Reset before $area_label" test_reset_environment
    if ! full_step "$area_label" crud_runner "$area"; then
      printf 'Restoring fixture sandbox after failed %s suite; diagnostic artifacts are retained.\n' "$area" >&2
      test_reset_environment || true
      return 1
    fi
  done
  full_step 'Final test reset' test_reset_environment
  full_step 'Fixture integrity' verify_fixtures
  full_step 'Final smoke' run_smoke
  full_step 'Log check' assert_clean_logs
  full_step 'Package scope' verify_package_scope
  full_step 'Lifecycle' lifecycle
  printf '\nFDShop full test suite: PASS\n'
}

lifecycle() {
  build_package
  compose down --volumes --remove-orphans
  compose up --detach --build
  wait_healthy
  compose exec -T joomla php --version
  compose exec -T joomla php cli/joomla.php --version
  compose exec -T db mariadb --version
  install_fdshop
  uninstall_fdshop
  install_fdshop
  assert_clean_logs
  collect_logs
  printf 'Fresh install -> uninstall -> fresh install completed successfully.\n'
}

usage() {
  cat <<'USAGE'
Usage: scripts/fdshop COMMAND

  start             Start/build Phase-1 services and wait until healthy
  stop              Stop services and retain all volumes
  rebuild           Rebuild images and retain all volumes
  reset             Remove only fdshop Compose resources/volumes, then start fresh
  package           Build deterministic .docker/artifacts/com_fdshop.zip
  install           Build and install/update through Joomla CLI
  uninstall         Uninstall through Joomla CLI and verify cleanup
  reinstall         Uninstall, then build/install through Joomla CLI
  sync              Fast source sync after a proper package installation
  verify-install    Verify extension record, schema and all FDShop tables
  verify-uninstall  Verify extension record and all FDShop tables are absent
  logs              Print current logs and collect them under .docker/logs
  check-logs        Fail on fatal PHP, uncaught exception or SQL errors
  fixtures          Reset FDShop domain data, load and verify fixtures
  fixtures-verify   Verify the existing fixture state without changing data
  test-reset        Phase-1 reset, install FDShop, then load fixtures
  smoke             Fast health, HTTP, FDShop, fixture and new-log checks
  browser           Run headless Chromium foundation test on prepared sandbox
  test-browser      Run test-reset, smoke and browser foundation test
  browser-readonly  Run read-only FDShop administrator browser regressions
  browser-frontend-category  Run the public category view browser suite with isolated fixtures
  browser-frontend-cart  Run the authenticated frontend cart browser suite with isolated fixtures
  browser-purchase  Run the central purchase action suite with isolated fixtures
  browser-products-module  Run the category products module multi-instance suite
  test-readonly     Run reset, smoke, foundation and read-only browser tests
  browser-crud-manufacturers  Run manufacturer CRUD browser tests
  browser-crud-categories  Run category CRUD browser tests with cleanup
  browser-crud-products  Run product CRUD browser tests with media cleanup
  browser-crud-coupons  Run coupon CRUD browser tests with mapping cleanup
  browser-crud-bundles  Run bundle CRUD browser tests with cleanup
  browser-crud-orders  Run order administration CRUD browser tests
  test-quick        Fast non-destructive smoke check on a prepared sandbox
  test-standard AREA  Reset, baseline, one CRUD area, integrity and logs
  test-full         Run the complete Phase-2 regression and lifecycle suite
  browser-crud-configuration  Run configuration, shipment, payment and order-status CRUD tests
  lifecycle         Reset and test fresh install -> uninstall -> fresh install
  test-packaging-migration  Rehearse the real 0.0.19 -> 0.0.20 data migration
  status            Show Compose service state
  versions          Show actual Joomla, PHP, Apache and MariaDB versions
USAGE
}

main() {
  cd "$REPO_ROOT"
  local command="${1:-}"
  case "$command" in
    ""|-h|--help|help) usage ;;
    package) build_package ;;
    *)
      load_env
      prepare_dirs
      case "$command" in
        start) compose up --detach --build; wait_healthy ;;
        stop) compose stop ;;
        rebuild) compose up --detach --build; wait_healthy ;;
        reset) compose down --volumes --remove-orphans; compose up --detach --build; wait_healthy ;;
        install) install_fdshop ;;
        uninstall) uninstall_fdshop ;;
        reinstall) uninstall_fdshop; install_fdshop ;;
        sync) sync_source ;;
        verify-install) verify_installed ;;
        verify-uninstall) verify_uninstalled ;;
        logs) compose logs --tail 200; collect_logs ;;
        check-logs) assert_clean_logs ;;
        fixtures) load_fixtures ;;
        fixtures-verify) verify_fixtures ;;
        test-reset) compose down --volumes --remove-orphans; compose up --detach --build; wait_healthy; install_fdshop; load_fixtures ;;
        smoke) run_smoke ;;
        browser) run_browser ;;
        test-browser) test_browser ;;
        browser-readonly) run_browser_readonly ;;
        browser-frontend-category) run_browser_frontend_category ;;
        browser-frontend-cart) run_browser_frontend_cart ;;
        browser-purchase) run_browser_purchase ;;
        browser-products-module) run_browser_products_module ;;
        test-readonly) test_readonly ;;
        browser-crud-manufacturers) run_browser_crud_manufacturers ;;
        browser-crud-categories) run_browser_crud_categories ;;
        browser-crud-products) run_browser_crud_products ;;
        browser-crud-coupons) run_browser_crud_coupons ;;
        browser-crud-bundles) run_browser_crud_bundles ;;
        browser-crud-orders) run_browser_crud_orders ;;
        browser-crud-configuration) run_browser_crud_configuration ;;
        test-quick) test_quick ;;
        test-standard) test_standard "${2:-}" ;;
        test-full) test_full ;;
        lifecycle) lifecycle ;;
        test-packaging-migration) test_packaging_migration ;;
        status) compose ps ;;
        versions)
          compose exec -T joomla php cli/joomla.php --version
          compose exec -T joomla php --version
          compose exec -T joomla apache2 -v
          compose exec -T db mariadb --version
          ;;
        *) usage; return 1 ;;
      esac
      ;;
  esac
}

main "$@"
