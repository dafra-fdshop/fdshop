#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly COMPOSE_PROJECT="fdshop"
readonly COMPOSE_FILE="$REPO_ROOT/compose.yaml"
readonly ENV_FILE="$REPO_ROOT/.env"
readonly ARTIFACT_DIR="$REPO_ROOT/.docker/artifacts"
readonly LOG_DIR="$REPO_ROOT/.docker/logs"
readonly PACKAGE_PATH="$ARTIFACT_DIR/com_fdshop.zip"

compose() {
  docker compose --project-name "$COMPOSE_PROJECT" --file "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
}

require_file() {
  if [[ ! -f "$1" ]]; then
    printf 'Required file is missing: %s\n' "$1" >&2
    [[ "$1" == "$ENV_FILE" ]] && printf 'Create it with: cp .env.example .env\n' >&2
    exit 1
  fi
}

prepare_dirs() {
  mkdir -p "$ARTIFACT_DIR" "$LOG_DIR"
}

build_package() {
  prepare_dirs
  [[ "$PACKAGE_PATH" == "$ARTIFACT_DIR/com_fdshop.zip" ]] || {
    printf 'Refusing to remove unexpected package path: %s\n' "$PACKAGE_PATH" >&2
    return 1
  }
  rm -f -- "$PACKAGE_PATH"
  local stage_dir
  stage_dir="$(mktemp -d -t fdshop-package.XXXXXXXX)"
  trap '[[ -n "${stage_dir:-}" && "$stage_dir" == /tmp/fdshop-package.* ]] && rm -rf -- "$stage_dir"' RETURN

  mkdir -p "$stage_dir/component" "$stage_dir/filter-module" "$stage_dir/products-module" "$stage_dir/user-plugin" "$stage_dir/system-plugin" "$stage_dir/package"
  cp -a "$REPO_ROOT/administrator" "$stage_dir/component/administrator"
  cp -a "$REPO_ROOT/site" "$stage_dir/component/site"
  cp -a "$REPO_ROOT/media" "$stage_dir/component/media"
  cp "$REPO_ROOT/fdshop.xml" "$REPO_ROOT/script.php" "$stage_dir/component/"
  cp -a "$REPO_ROOT/modules/mod_fdshop_filter/." "$stage_dir/filter-module/"
  cp -a "$REPO_ROOT/modules/mod_fdshop_products/." "$stage_dir/products-module/"
  cp -a "$REPO_ROOT/plugins/user/fdshopprofile/." "$stage_dir/user-plugin/"
  cp -a "$REPO_ROOT/plugins/system/fdshopregistration/." "$stage_dir/system-plugin/"
  find "$stage_dir" -exec touch -h -d '2000-01-01 00:00:00 UTC' {} +
  ( cd "$stage_dir/component"; find administrator site media -type f -print | LC_ALL=C sort | zip -X -q "$stage_dir/package/com_fdshop_component.zip" -@; zip -X -q "$stage_dir/package/com_fdshop_component.zip" fdshop.xml script.php )
  ( cd "$stage_dir/filter-module"; find . -type f -print | LC_ALL=C sort | zip -X -q "$stage_dir/package/mod_fdshop_filter.zip" -@ )
  ( cd "$stage_dir/products-module"; find . -type f -print | LC_ALL=C sort | zip -X -q "$stage_dir/package/mod_fdshop_products.zip" -@ )
  ( cd "$stage_dir/user-plugin"; find . -type f -print | LC_ALL=C sort | zip -X -q "$stage_dir/package/plg_user_fdshopprofile.zip" -@ )
  ( cd "$stage_dir/system-plugin"; find . -type f -print | LC_ALL=C sort | zip -X -q "$stage_dir/package/plg_system_fdshopregistration.zip" -@ )
  cp "$REPO_ROOT/pkg_fdshop.xml" "$stage_dir/package/"
  touch -d '2000-01-01 00:00:00 UTC' "$stage_dir/package/"*
  ( cd "$stage_dir/package"; zip -X -q "$PACKAGE_PATH" plg_user_fdshopprofile.zip plg_system_fdshopregistration.zip com_fdshop_component.zip mod_fdshop_filter.zip mod_fdshop_products.zip pkg_fdshop.xml )

  printf 'Built %s\n' "$PACKAGE_PATH"
  sha256sum "$PACKAGE_PATH"
}

wait_healthy() {
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    local db_health joomla_health mailpit_health
    db_health="$(compose ps --format json db 2>/dev/null | grep -o '"Health":"[^"]*"' | head -1 || true)"
    joomla_health="$(compose ps --format json joomla 2>/dev/null | grep -o '"Health":"[^"]*"' | head -1 || true)"
    mailpit_health="$(compose ps --format json mailpit 2>/dev/null | grep -o '"Health":"[^"]*"' | head -1 || true)"
    if [[ "$db_health" == *healthy* && "$joomla_health" == *healthy* && "$mailpit_health" == *healthy* ]]; then
      printf 'All FDShop services are healthy.\n'
      return 0
    fi
    sleep 5
  done
  compose ps
  compose logs --tail 100
  printf 'Timed out waiting for healthy services.\n' >&2
  return 1
}

sql() {
  compose exec -T --env "MYSQL_PWD=${MARIADB_PASSWORD}" db mariadb \
    --batch --skip-column-names \
    --user="${MARIADB_USER}" \
    "${MARIADB_DATABASE}" \
    --execute "$1"
}

load_env() {
  require_file "$ENV_FILE"
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
  : "${MARIADB_DATABASE:?Missing MARIADB_DATABASE in .env}"
  : "${MARIADB_USER:?Missing MARIADB_USER in .env}"
  : "${MARIADB_PASSWORD:?Missing MARIADB_PASSWORD in .env}"
  : "${JOOMLA_DB_PREFIX:=fd_}"
}

extension_id() {
  sql "SELECT extension_id FROM ${JOOMLA_DB_PREFIX}extensions WHERE type='component' AND element='com_fdshop' LIMIT 1;"
}

package_extension_id() {
  sql "SELECT extension_id FROM ${JOOMLA_DB_PREFIX}extensions WHERE type='package' AND element='pkg_fdshop' LIMIT 1;"
}

verify_installed() {
  local id actual_tables expected_tables schema_version expected_schema_version
  id="$(extension_id)"
  [[ "$id" =~ ^[0-9]+$ ]] || { printf 'FDShop extension record is missing.\n' >&2; return 1; }

  expected_tables="$(grep -oE '#__fdshop_[A-Za-z0-9_]+' "$REPO_ROOT/administrator/sql/install.mysql.utf8.sql" | sort -u | wc -l)"
  actual_tables="$(sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${MARIADB_DATABASE}' AND table_name LIKE '${JOOMLA_DB_PREFIX}fdshop\\_%';")"
  [[ "$actual_tables" == "$expected_tables" ]] || {
    printf 'FDShop table count mismatch: expected %s, found %s.\n' "$expected_tables" "$actual_tables" >&2
    return 1
  }

  expected_schema_version="$(find "$REPO_ROOT/administrator/sql/updates" -maxdepth 1 -type f -name '*.sql' -printf '%f\n' | sed 's/\.sql$//' | sort -V | tail -1)"
  schema_version="$(sql "SELECT version_id FROM ${JOOMLA_DB_PREFIX}schemas WHERE extension_id=${id};")"
  [[ "$schema_version" == "$expected_schema_version" ]] || {
    printf 'Schema mismatch: latest migration %s, Joomla %s.\n' "$expected_schema_version" "$schema_version" >&2
    return 1
  }

  compose exec -T joomla test -f /var/www/html/administrator/components/com_fdshop/fdshop.xml
  compose exec -T joomla test -d /var/www/html/components/com_fdshop
  compose exec -T joomla test -f /var/www/html/media/com_fdshop/joomla.asset.json
  compose exec -T joomla test -d /var/www/html/images/FDShop/products
  compose exec -T joomla test -f /var/www/html/modules/mod_fdshop_filter/mod_fdshop_filter.php
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}extensions WHERE type='module' AND element='mod_fdshop_filter' AND client_id=0;")" == "1" ]]
  compose exec -T joomla test -f /var/www/html/modules/mod_fdshop_products/mod_fdshop_products.php
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}extensions WHERE type='module' AND element='mod_fdshop_products' AND client_id=0;")" == "1" ]]
  compose exec -T joomla test -f /var/www/html/plugins/user/fdshopprofile/services/provider.php
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}extensions WHERE type='plugin' AND folder='user' AND element='fdshopprofile' AND enabled=1;")" == "1" ]]
  compose exec -T joomla test -f /var/www/html/plugins/system/fdshopregistration/services/provider.php
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}extensions WHERE type='plugin' AND folder='system' AND element='fdshopregistration' AND enabled=1;")" == "1" ]]

  printf 'FDShop installed: extension_id=%s, schema=%s, tables=%s; installation paths present.\n' "$id" "$schema_version" "$actual_tables"
}

verify_uninstalled() {
  local id actual_tables
  id="$(extension_id)"
  actual_tables="$(sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${MARIADB_DATABASE}' AND table_name LIKE '${JOOMLA_DB_PREFIX}fdshop\\_%';")"
  [[ -z "$id" ]] || { printf 'FDShop extension record still exists: %s\n' "$id" >&2; return 1; }
  [[ "$actual_tables" == "0" ]] || { printf 'FDShop tables remain after uninstall: %s\n' "$actual_tables" >&2; return 1; }
  compose exec -T joomla test ! -e /var/www/html/administrator/components/com_fdshop
  compose exec -T joomla test ! -e /var/www/html/components/com_fdshop
  compose exec -T joomla test ! -e /var/www/html/media/com_fdshop
  compose exec -T joomla test ! -e /var/www/html/modules/mod_fdshop_filter
  compose exec -T joomla test ! -e /var/www/html/modules/mod_fdshop_products
  compose exec -T joomla test ! -e /var/www/html/plugins/user/fdshopprofile
  compose exec -T joomla test ! -e /var/www/html/plugins/system/fdshopregistration
  printf 'FDShop uninstalled: extension record absent, tables=0, component paths absent.\n'
}

install_fdshop() {
  local container_package="/var/www/html/tmp/com_fdshop.zip"

  build_package

  compose exec -T --user root joomla install \
    --owner=www-data \
    --group=www-data \
    --mode=0644 \
    /workspace/artifacts/com_fdshop.zip \
    "$container_package"

  if ! compose exec -T --user www-data joomla php cli/joomla.php extension:install \
    --path="$container_package" --no-interaction; then
    compose exec -T --user root joomla rm -f "$container_package"
    return 1
  fi

  compose exec -T --user root joomla rm -f "$container_package"
  verify_installed
}

uninstall_fdshop() {
  local id
  id="$(package_extension_id)"
  [[ "$id" =~ ^[0-9]+$ ]] || id="$(extension_id)"
  [[ "$id" =~ ^[0-9]+$ ]] || { printf 'FDShop is not installed.\n' >&2; return 1; }
  compose exec -T joomla php cli/joomla.php extension:remove "$id" --no-interaction
  verify_uninstalled
}

sync_source() {
  compose exec -T --user root joomla bash -Eeuo pipefail -c '
    test -d /var/www/html/administrator/components/com_fdshop
    rsync -a --delete /workspace/fdshop/administrator/ /var/www/html/administrator/components/com_fdshop/
    cp /workspace/fdshop/fdshop.xml /var/www/html/administrator/components/com_fdshop/fdshop.xml
    rsync -a --delete /workspace/fdshop/site/ /var/www/html/components/com_fdshop/
    rsync -a --delete /workspace/fdshop/media/css/ /var/www/html/media/com_fdshop/css/
    rsync -a --delete /workspace/fdshop/media/js/ /var/www/html/media/com_fdshop/js/
    rsync -a --delete /workspace/fdshop/media/images/ /var/www/html/media/com_fdshop/images/
    cp /workspace/fdshop/media/joomla.asset.json /var/www/html/media/com_fdshop/joomla.asset.json
    test ! -d /var/www/html/modules/mod_fdshop_filter || rsync -a --delete /workspace/fdshop/modules/mod_fdshop_filter/ /var/www/html/modules/mod_fdshop_filter/
    test ! -d /var/www/html/modules/mod_fdshop_products || rsync -a --delete /workspace/fdshop/modules/mod_fdshop_products/ /var/www/html/modules/mod_fdshop_products/
    test ! -d /var/www/html/plugins/user/fdshopprofile || rsync -a --delete /workspace/fdshop/plugins/user/fdshopprofile/ /var/www/html/plugins/user/fdshopprofile/
    test ! -d /var/www/html/plugins/system/fdshopregistration || rsync -a --delete /workspace/fdshop/plugins/system/fdshopregistration/ /var/www/html/plugins/system/fdshopregistration/
    chown -R www-data:www-data /var/www/html/administrator/components/com_fdshop /var/www/html/components/com_fdshop /var/www/html/media/com_fdshop /var/www/html/modules/mod_fdshop_filter /var/www/html/modules/mod_fdshop_products /var/www/html/plugins/user/fdshopprofile /var/www/html/plugins/system/fdshopregistration 2>/dev/null || true
  '
  printf 'FDShop source synchronized. Manifest and installer lifecycle were not bypassed.\n'
}

collect_logs() {
  prepare_dirs
  local stamp target
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  target="$LOG_DIR/$stamp"
  mkdir -p "$target"
  compose ps >"$target/compose-ps.txt"
  compose logs --no-color >"$target/compose.log"
  compose exec -T joomla sh -c 'find /var/www/html/administrator/logs -maxdepth 1 -type f -print -exec tail -n 500 {} \;' >"$target/joomla.log" 2>&1 || true
  printf 'Logs collected in %s\n' "$target"
}

assert_clean_logs() {
  local combined
  combined="$(mktemp -t fdshop-log-check.XXXXXXXX)"
  trap '[[ -n "${combined:-}" && "$combined" == /tmp/fdshop-log-check.* ]] && rm -f -- "$combined"' RETURN
  compose logs --no-color >"$combined"
  compose exec -T joomla sh -c 'find /var/www/html/administrator/logs -maxdepth 1 -type f -exec cat {} \;' >>"$combined" 2>/dev/null || true
  if grep -E -i 'PHP Fatal error|Uncaught (Error|Exception)|SQLSTATE\[|mysqli_sql_exception|Joomla[^:]*: error' "$combined"; then
    printf 'Serious errors were found in the Phase-1 logs.\n' >&2
    return 1
  fi
  printf 'No fatal PHP, uncaught exception or SQL error found in current logs.\n'
}

load_fixtures() {
  bash "$REPO_ROOT/tests/fixtures/bin/load.sh"
}

load_frontend_category_fixtures() {
  bash "$REPO_ROOT/tests/fixtures/bin/load-frontend-category.sh"
}

load_frontend_cart_fixtures() {
  bash "$REPO_ROOT/tests/fixtures/bin/load-frontend-cart.sh"
}

verify_fixtures() {
  bash "$REPO_ROOT/tests/fixtures/bin/verify.sh"
}

run_smoke() {
  bash "$REPO_ROOT/tests/smoke/run.sh"
}

run_browser() {
  verify_installed >/dev/null
  verify_fixtures >/dev/null

  local run_id="${FDSHOP_BROWSER_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$RANDOM}"
  [[ "$run_id" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'Invalid browser run id.\n' >&2; return 1; }
  local container_output="/workspace/artifacts/$run_id"
  local host_output="$REPO_ROOT/.docker/test-results/playwright/$run_id"
  mkdir -p "$host_output"

  compose build browser
  if compose run --rm --no-deps \
    --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" \
    --env "FDSHOP_BROWSER_INJECT_FAILURE=${FDSHOP_BROWSER_INJECT_FAILURE:-}" \
    browser npx playwright test tests/foundation.spec.js; then
    printf 'Browser artifacts: %s\nFDShop browser test: PASS\n' "$host_output"
  else
    printf 'Browser artifacts: %s\nFDShop browser test: FAIL\n' "$host_output" >&2
    return 1
  fi
}

run_browser_readonly() {
  verify_installed >/dev/null
  verify_fixtures >/dev/null
  local run_id="${FDSHOP_READONLY_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-readonly-$RANDOM}"
  [[ "$run_id" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'Invalid read-only run id.\n' >&2; return 1; }
  local container_output="/workspace/artifacts/$run_id"
  local host_output="$REPO_ROOT/.docker/test-results/playwright/$run_id"
  mkdir -p "$host_output"
  compose build browser
  if compose run --rm --no-deps \
    --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" \
    --env "FDSHOP_READONLY_INJECT_FAILURE=${FDSHOP_READONLY_INJECT_FAILURE:-}" \
    browser npx playwright test tests/readonly.spec.js; then
    printf 'Browser read-only artifacts: %s\nFDShop browser read-only suite: PASS\n' "$host_output"
  else
    printf 'Browser read-only artifacts: %s\nFDShop browser read-only suite: FAIL\n' "$host_output" >&2
    return 1
  fi
}

run_browser_frontend_category() {
  verify_installed >/dev/null
  verify_fixtures >/dev/null
  local run_id="${FDSHOP_FRONTEND_CATEGORY_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-frontend-category-$RANDOM}"
  [[ "$run_id" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'Invalid frontend category run id.\n' >&2; return 1; }
  local container_output="/workspace/artifacts/$run_id"
  local host_output="$REPO_ROOT/.docker/test-results/playwright/$run_id"
  mkdir -p "$host_output"
  load_frontend_category_fixtures
  compose build browser

  if compose run --rm --no-deps \
    --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" \
    browser npx playwright test tests/frontend-category.spec.js tests/filter-function.spec.js tests/filter-admin.spec.js \
      --grep-invert 'mobile availability follows the Joomla module context'; then
    local module_id straight_id fanned_id roman_candle_id
    module_id="$(sql "SELECT id FROM ${JOOMLA_DB_PREFIX}modules WHERE client_id=0 AND module='mod_fdshop_filter' ORDER BY id LIMIT 1;")"
    straight_id="$(sql "SELECT id FROM ${JOOMLA_DB_PREFIX}fdshop_filter_options WHERE option_key='straight';")"
    fanned_id="$(sql "SELECT id FROM ${JOOMLA_DB_PREFIX}fdshop_filter_options WHERE option_key='fanned';")"
    roman_candle_id="$(sql "SELECT id FROM ${JOOMLA_DB_PREFIX}fdshop_filter_options WHERE option_key='roman_candle';")"

    sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET publish_down='2000-01-01 00:00:00' WHERE id=${module_id};"
    if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output-module-expired" browser npx playwright test tests/filter-function.spec.js --grep 'mobile availability follows the Joomla module context'; then
      printf 'Expired module context check failed.\n' >&2; load_fixtures || true; return 1
    fi
    sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET publish_down=NULL WHERE id=${module_id}; UPDATE ${JOOMLA_DB_PREFIX}modules_menu SET menuid=-900900 WHERE moduleid=${module_id};"
    if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output-module-excluded" browser npx playwright test tests/filter-function.spec.js --grep 'mobile availability follows the Joomla module context'; then
      printf 'Excluded menu context check failed.\n' >&2; load_fixtures || true; return 1
    fi
    sql "UPDATE ${JOOMLA_DB_PREFIX}modules_menu SET menuid=900900 WHERE moduleid=${module_id}; UPDATE ${JOOMLA_DB_PREFIX}modules SET published=0 WHERE id=${module_id};"
    if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output-module-hidden" browser npx playwright test tests/filter-function.spec.js --grep 'mobile availability follows the Joomla module context'; then
      printf 'Hidden module context check failed.\n' >&2; load_fixtures || true; return 1
    fi
    sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET published=1 WHERE id=${module_id}; UPDATE ${JOOMLA_DB_PREFIX}fdshop_filter_options SET is_active=0 WHERE id IN (${straight_id},${fanned_id});"
    if ! compose run --rm --no-deps \
      --env "PLAYWRIGHT_OUTPUT_DIR=$container_output-option-persistence" \
      --env "FDSHOP_FILTER_STRAIGHT_ID=$straight_id" \
      --env "FDSHOP_FILTER_FANNED_ID=$fanned_id" \
      --env "FDSHOP_FILTER_ROMAN_CANDLE_ID=$roman_candle_id" \
      browser npx playwright test tests/filter-option-persistence.spec.js; then
      printf 'Inactive filter option persistence check failed.\n' >&2; load_fixtures || true; return 1
    fi
    load_fixtures >/dev/null
    printf 'Frontend category artifacts: %s\nFDShop frontend category suite: PASS (targeted data and cleanup verified)\n' "$host_output"
  else
    printf 'Frontend category artifacts: %s\nFDShop frontend category suite: FAIL; restoring base fixtures.\n' "$host_output" >&2
    load_fixtures || true
    return 1
  fi
}

run_browser_products_module() {
  verify_installed >/dev/null
  load_fixtures >/dev/null
  local category_id module_ids="" params module_id first_module_id="" run_id container_output host_output one_time eight_time
  category_id="$(sql "SELECT id FROM ${JOOMLA_DB_PREFIX}fdshop_categories WHERE is_active=1 ORDER BY id LIMIT 1;")"
  [[ "$category_id" =~ ^[0-9]+$ ]] || { printf 'No active FDShop category found.\n' >&2; return 1; }
  sql "DELETE mm FROM ${JOOMLA_DB_PREFIX}modules_menu mm INNER JOIN ${JOOMLA_DB_PREFIX}modules m ON m.id=mm.moduleid WHERE m.module='mod_fdshop_products' AND m.title LIKE 'FDShop Produkte %'; DELETE FROM ${JOOMLA_DB_PREFIX}modules WHERE module='mod_fdshop_products' AND title LIKE 'FDShop Produkte %';"
  sql "INSERT IGNORE INTO ${JOOMLA_DB_PREFIX}fdshop_product_category_map (product_id, category_id) SELECT id, ${category_id} FROM ${JOOMLA_DB_PREFIX}fdshop_products WHERE is_active=1 AND is_deleted=0;"
  params="{\"category_id\":\"${category_id}\",\"max_products\":\"8\",\"desktop_items\":\"5\",\"sorting\":\"name_asc\",\"show_category_link\":\"1\",\"category_link_text\":\"Zur Kategorie\",\"show_ribbons\":\"1\",\"show_technical\":\"1\",\"show_price\":\"1\",\"show_cart\":\"1\",\"carousel\":\"1\",\"cache\":\"0\",\"cache_time\":\"300\"}"
  for number in $(seq 1 8); do
    sql "INSERT INTO ${JOOMLA_DB_PREFIX}modules (asset_id,title,note,content,ordering,position,checked_out,checked_out_time,publish_up,publish_down,published,module,access,showtitle,params,client_id,language) VALUES (0,'FDShop Produkte ${number}','','',${number},'main-top',NULL,NULL,NULL,NULL,1,'mod_fdshop_products',1,0,'${params}',0,'*');"
    module_id="$(sql "SELECT id FROM ${JOOMLA_DB_PREFIX}modules WHERE client_id=0 AND module='mod_fdshop_products' AND title='FDShop Produkte ${number}' ORDER BY id DESC LIMIT 1;")"
    [[ -n "$first_module_id" ]] || first_module_id="$module_id"
    sql "INSERT INTO ${JOOMLA_DB_PREFIX}modules_menu (moduleid,menuid) VALUES (${module_id},0);"
    module_ids="${module_ids}${module_ids:+,}${module_id}"
  done
  sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET params=JSON_SET(params, '$.link_category', 'none') WHERE title='FDShop Produkte 1';"
  sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET params=JSON_SET(params, '$.link_category', 'title_button', '$.category_link_text', 'Alle Artikel') WHERE title='FDShop Produkte 2';"
  sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET params=JSON_SET(params, '$.link_category', 'title_only') WHERE title='FDShop Produkte 3';"
  sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET params=JSON_SET(params, '$.show_category_link', '0') WHERE title='FDShop Produkte 4';"
  sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET showtitle=1 WHERE title='FDShop Produkte 6';"
  sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET params=JSON_SET(params, '$.cache', '1') WHERE module='mod_fdshop_products' AND title LIKE 'FDShop Produkte %' ORDER BY id DESC LIMIT 4;"
  sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET params=JSON_SET(params, '$.carousel', '0') WHERE id=${module_id};"
  sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET published=0 WHERE id IN (${module_ids}) AND id<>${first_module_id};"
  one_time="$(curl --silent --output /dev/null --write-out '%{time_total}' "http://127.0.0.1:8080/index.php?option=com_fdshop&view=category&id=${category_id}")"
  sql "UPDATE ${JOOMLA_DB_PREFIX}modules SET published=1 WHERE id IN (${module_ids});"
  eight_time="$(curl --silent --output /dev/null --write-out '%{time_total}' "http://127.0.0.1:8080/index.php?option=com_fdshop&view=category&id=${category_id}")"
  printf 'Products module render timing: 1 instance=%ss, 8 instances=%ss (three queries first configuration, request-cache hits thereafter).\n' "$one_time" "$eight_time"
  run_id="${FDSHOP_PRODUCTS_MODULE_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-products-module-$RANDOM}"
  container_output="/workspace/artifacts/$run_id"; host_output="$REPO_ROOT/.docker/test-results/playwright/$run_id"; mkdir -p "$host_output"
  compose build browser
  if compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" --env "FDSHOP_PRODUCTS_MODULE_CATEGORY_ID=$category_id" browser npx playwright test tests/products-module.spec.js; then
    printf 'Products module artifacts: %s\nFDShop products module suite: PASS\n' "$host_output"
  else
    sql "DELETE FROM ${JOOMLA_DB_PREFIX}modules WHERE id IN (${module_ids});" || true; load_fixtures >/dev/null || true; return 1
  fi
  sql "DELETE FROM ${JOOMLA_DB_PREFIX}modules WHERE id IN (${module_ids});"
  load_fixtures >/dev/null
}

