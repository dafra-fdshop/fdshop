}
run_browser_crud_orders() {
  verify_installed >/dev/null; verify_fixtures >/dev/null
  local run_id="${FDSHOP_ORDERS_CRUD_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-orders-crud-$RANDOM}"
  [[ "$run_id" =~ ^[A-Za-z0-9._-]+$ ]] || { printf 'Invalid orders CRUD run id.\n' >&2; return 1; }
  local container_output="/workspace/artifacts/$run_id" host_output="$REPO_ROOT/.docker/test-results/playwright/$run_id"
  mkdir -p "$host_output"
  sql "INSERT INTO ${JOOMLA_DB_PREFIX}fdshop_shipments (id,shipment_name,shipment_description,shipment_color,shipment_price,published,is_default,ordering,created,created_by) VALUES (900602,'E2E Versand Alternativ','Transaktionaler Bestelltest','#778899',7.50,1,0,30,NOW(),0); INSERT INTO ${JOOMLA_DB_PREFIX}fdshop_order_statuses (id,status_code,status_name,description,notify_seller,notify_buyer,create_invoice,stock_action,seller_email_mode,buyer_email_mode,is_active,ordering,created,created_by) VALUES (900704,'e2e-cancelled','E2E Storniert','Transaktionaler Bestelltest',0,1,0,'available','config','account',1,40,NOW(),0); UPDATE ${JOOMLA_DB_PREFIX}fdshop_orders SET stock_state='reserved',shipment_name='E2E Versand Standard',shipment_fee=4.99,payment_method_name='E2E Zahlung Rechnung',payment_fee=0,subtotal=19.99,coupon_code='E2E-FIXED',coupon_discount=5.00,customer_email='e2e-buyer@example.test',modified=NULL WHERE id=900800; UPDATE ${JOOMLA_DB_PREFIX}fdshop_orders SET stock_state='deducted',shipment_name='E2E Versand Standard',shipment_fee=4.99,payment_method_name='E2E Zahlung Rechnung',payment_fee=0,subtotal=106.015,coupon_discount=0,customer_email='invalid',modified=NULL WHERE id=900801; INSERT INTO ${JOOMLA_DB_PREFIX}fdshop_order_stock_allocations (order_id,product_id,physical_quantity,stock_state,created) VALUES (900800,900100,1,'reserved',NOW()),(900801,900100,1,'deducted',NOW()),(900801,900105,2,'deducted',NOW()); UPDATE ${JOOMLA_DB_PREFIX}fdshop_products_details SET stock_quantity=4,low_stock=2,reserved_quantity=1 WHERE product_id=900100; UPDATE ${JOOMLA_DB_PREFIX}fdshop_products SET in_stock='Verfügbar' WHERE id IN (900100,900105);"
  local mail_count_before; mail_count_before="$(compose exec -T joomla php -r '$data=json_decode(file_get_contents("http://mailpit:8025/api/v1/messages"),true); echo (int)($data["messages_count"] ?? count($data["messages"] ?? []));')"
  compose build browser
  if ! compose run --rm --no-deps --env "PLAYWRIGHT_OUTPUT_DIR=$container_output" browser npx playwright test tests/orders-crud.spec.js; then
    printf 'Order CRUD artifacts: %s\nFDShop order CRUD suite: FAIL\n' "$host_output" >&2; load_fixtures || true; return 1
  fi
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_orders WHERE id=900800 AND order_status_id=900701 AND order_status='e2e-shipped' AND stock_state='deducted' AND shipment_id=900602 AND shipment_fee=7.5000 AND subtotal=19.9900 AND coupon_code='E2E-FIXED' AND coupon_discount=5.0000 AND grand_total=22.4900;")" == 1 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_items WHERE id=900810 AND product_name='E2E Produkt Aktiv' AND sku='E2E-PROD-ACTIVE' AND gtin='9900000000001' AND manufacturer_name='E2E Hersteller Aktiv' AND quantity=1 AND unit_price_gross=19.9900 AND line_total_gross=19.9900 AND is_removed=0;")" == 1 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_items WHERE order_id=900800 AND product_id=900105 AND quantity=2 AND unit_price_gross=39.9900 AND is_removed=1;")" == 1 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_history WHERE order_id=900800 AND event_type='order_changed';")" == 3 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_history WHERE order_id=900800 AND event_type='mail_buyer_order_changed';")" == 3 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_stock_allocations WHERE order_id=900800 AND product_id=900100 AND physical_quantity=1 AND stock_state='deducted';")" == 1 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_stock_allocations WHERE order_id=900800 AND product_id=900105;")" == 0 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_products p JOIN ${JOOMLA_DB_PREFIX}fdshop_products_details d ON d.product_id=p.id WHERE p.id=900100 AND d.stock_quantity=3 AND d.reserved_quantity=0 AND p.in_stock='Verfügbar';")" == 1 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_products p JOIN ${JOOMLA_DB_PREFIX}fdshop_products_details d ON d.product_id=p.id WHERE p.id=900105 AND d.reserved_quantity=0 AND p.in_stock='Verfügbar';")" == 1 ]]
  local mail_count_after; mail_count_after="$(compose exec -T joomla php -r '$data=json_decode(file_get_contents("http://mailpit:8025/api/v1/messages"),true); echo (int)($data["messages_count"] ?? count($data["messages"] ?? []));')"; (( mail_count_after == mail_count_before + 7 ))
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_bundles WHERE order_id=900801 AND bundle_id=900400;")" == 1 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_bundle_items WHERE order_bundle_id=900820;")" == 2 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_orders WHERE id=900801 AND stock_state='deducted' AND shipment_id=900602 AND shipment_fee=7.5000;")" == 1 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_items WHERE id=900811 AND quantity=1 AND is_removed=0;")" == 1 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_history WHERE order_id=900801 AND event_type='order_changed';")" == 1 ]]
  [[ "$(sql "SELECT COUNT(*) FROM ${JOOMLA_DB_PREFIX}fdshop_order_history WHERE order_id=900801 AND event_type='mail_buyer_order_changed_failed';")" == 1 ]]
  load_fixtures >/dev/null
  printf 'Order CRUD artifacts: %s\nFDShop order CRUD suite: PASS (snapshots, totals and histories verified)\n' "$host_output"
}

