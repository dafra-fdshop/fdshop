<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_FDSHOP_FILTER_SEARCH_LABEL"
            description="Hier können Sie nach Gutscheinname, Code, Alias oder Beschreibung suchen"
            hint="Suche eingeben"
        />

        <field
            name="published"
            type="list"
            label="Status"
            class="js-select-submit-on-change"
        >
            <option value="">Status auswählen</option>
            <option value="1">Veröffentlicht</option>
            <option value="0">Deaktiviert</option>
        </field>
    </fields>

    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="a.id DESC"
            class="js-select-submit-on-change"
        >
            <option value="a.id DESC">ID DESC</option>
            <option value="a.id ASC">ID ASC</option>
            <option value="a.published ASC">Status ASC</option>
            <option value="a.published DESC">Status DESC</option>
            <option value="a.coupon_name ASC">Name ASC</option>
            <option value="a.coupon_name DESC">Name DESC</option>
            <option value="a.coupon_code ASC">Code ASC</option>
            <option value="a.coupon_code DESC">Code DESC</option>
            <option value="a.discount_value ASC">Rabatt ASC</option>
            <option value="a.discount_value DESC">Rabatt DESC</option>
            <option value="a.discount_type ASC">Typ ASC</option>
            <option value="a.discount_type DESC">Typ DESC</option>
            <option value="a.minimum_order_total ASC">Mindestbestellwert ASC</option>
            <option value="a.minimum_order_total DESC">Mindestbestellwert DESC</option>
            <option value="a.valid_from ASC">Gültig ab ASC</option>
            <option value="a.valid_from DESC">Gültig ab DESC</option>
            <option value="a.valid_to ASC">Gültig bis ASC</option>
            <option value="a.valid_to DESC">Gültig bis DESC</option>
            <option value="a.ordering ASC">Reihenfolge ASC</option>
            <option value="a.ordering DESC">Reihenfolge DESC</option>
        </field>

        <field
            name="limit"
            type="limitbox"
            default="20"
            class="js-select-submit-on-change"
        />
    </fields>
</form>
