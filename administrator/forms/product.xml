<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields>
        <fieldset name="basic" label="Produkt">
            <field
                name="id"
                type="hidden"
                default="0"
            />

            <field
                name="product_name"
                type="text"
                label="Produktname"
                required="true"
                size="40"
            />

            <field
                name="sku"
                type="text"
                label="Artikelnummer (SKU)"
                size="40"
            />

            <field
                name="gtin"
                type="text"
                label="GTIN/EAN"
                size="40"
				description="EAN Code"
            />

            <field
                name="alias"
                type="text"
                label="Alias"
                size="40"
				description="Leer = Wird automatisch gefüllt"
            />

            <field name="bundle_eligible" type="radio" label="Produkt Bundle-Fähig" default="0" class="btn-group btn-group-yesno">
                <option value="1">Ja</option>
                <option value="0">Nein</option>
            </field>

            <field
                name="manufacturer_id"
                type="sql"
                label="Hersteller"
                query="SELECT 0 AS value, '- Kein Hersteller -' AS text UNION SELECT id AS value, manufacturer_name AS text FROM #__fdshop_manufacturers ORDER BY text ASC"
                key_field="value"
                value_field="text"
                default="0"
            />

            <field
                name="category_ids"
                type="sql"
                label="Kategorien"
                query="SELECT id AS value, category_name AS text FROM #__fdshop_categories ORDER BY category_name ASC"
                key_field="value"
                value_field="text"
                multiple="true"
                size="12"
				description="Mehrfachauswahl durch drücken der 'Strg'-Taste"
            />

            <field name="buyer_group_id" type="sql" label="Käufergruppe" required="true"
                query="SELECT id AS value, group_name AS text FROM #__fdshop_buyer_groups WHERE is_active = 1 AND alias IN ('standard','permit_holder') ORDER BY ordering ASC"
                key_field="value" value_field="text" default="">
                <option value="">– Bitte auswählen –</option>
            </field>

            <field
                name="short_description"
                type="textarea"
                label="Kurzbeschreibung"
                rows="4"
                cols="60"
                filter="string"
            />

            <field
                name="description"
                type="textarea"
                label="Produktbeschreibung"
                rows="8"
                cols="60"
                filter="string"
            />
        </fieldset>

        <fieldset name="pricing" label="Preis">
            <field
                name="sale_price"
                type="number"
                label="Verkaufspreis"
                step="0.01"
                min="0"
            />

            <field
                name="discount_price"
                type="number"
                label="Rabattpreis"
                step="0.01"
                min="0"
            />

            <field
                name="discount_active"
                type="radio"
                label="Rabatt aktiv"
                default="0"
                class="btn-group btn-group-yesno"
            >
                <option value="1">Ja</option>
                <option value="0">Nein</option>
            </field>

            <field
                name="currency"
                type="text"
                label="Währung"
                size="10"
                default="EUR"
            />
        </fieldset>

        <fieldset name="stock" label="Lager">
            <field
                name="stock_quantity"
                type="number"
                label="Lagerbestand"
                step="1"
                min="0"
            />

            <field
                name="low_stock"
                type="number"
                label="Schwellwert wenig Bestand"
                step="1"
                min="0"
            />

            <field
                name="reserved_quantity"
                type="number"
                label="Reserviert"
                step="0.001"
                min="0"
            />

            <field
                name="sold_quantity"
                type="number"
                label="Verkaufte Menge"
                step="0.001"
                min="0"
            />

            <field
                name="is_in_stock"
                type="radio"
                label="Direkt auf Lager"
                default="0"
                class="btn-group btn-group-yesno"
            >
                <option value="1">Ja</option>
                <option value="0">Nein</option>
            </field>

            <field
                name="available_from"
                type="calendar"
                label="Verfügbar ab"
                format="%Y-%m-%d %H:%M:%S"
                filter="raw"
				description="Ab wann vorraussichtlich im Lager"
            />

            <field
                name="min_order_qty"
                type="number"
                label="Mindestbestellmenge"
                step="0.001"
                min="0"
                default="1"
            />

            <field
                name="max_order_qty"
                type="number"
                label="Maximalbestellmenge"
                step="0.001"
                min="0"
            />

            <field
                name="step_order_qty"
                type="number"
                label="Bestellschritt"
                step="0.001"
                min="0"
                default="1"
            />
			
			<field
				name="in_stock"
				type="text"
				label="Bestandsstatus"
				readonly="true"
				class="readonly"
				description="Wird automatisch aus Lagerdaten berechnet"
			/>	
			
        </fieldset>

        <fieldset name="publishing" label="Veröffentlichung">

<field
                name="is_active"
                type="radio"
                label="Veröffentlicht"
                default="0"
                class="btn-group btn-group-yesno"
            >
                <option value="1">Ja</option>
                <option value="0">Nein</option>
            </field>

            <field
                name="publish_up"
                type="calendar"
                label="Veröffentlichen ab"
                format="%Y-%m-%d %H:%M:%S"
                filter="raw"
            />

            <field
                name="publish_down"
                type="calendar"
                label="Veröffentlichen bis"
                format="%Y-%m-%d %H:%M:%S"
                filter="raw"
            />
        </fieldset>

        <fieldset name="beschreibung" label="Beschreibung">
            <field
                name="meta_product_type"
                type="list"
                label="COM_FDSHOP_FIELD_META_PRODUCT_TYPE_LABEL"
                description="COM_FDSHOP_FIELD_META_PRODUCT_TYPE_DESC"
                filter="cmd"
            >
                <option value="">COM_FDSHOP_META_PRODUCT_TYPE_SELECT</option>
                <option value="fireworks_battery">COM_FDSHOP_META_PRODUCT_TYPE_FIREWORKS_BATTERY</option>
                <option value="compound_fireworks">COM_FDSHOP_META_PRODUCT_TYPE_COMPOUND_FIREWORKS</option>
                <option value="rocket">COM_FDSHOP_META_PRODUCT_TYPE_ROCKET</option>
                <option value="rocket_assortment">COM_FDSHOP_META_PRODUCT_TYPE_ROCKET_ASSORTMENT</option>
                <option value="single_shot">COM_FDSHOP_META_PRODUCT_TYPE_SINGLE_SHOT</option>
                <option value="fountain">COM_FDSHOP_META_PRODUCT_TYPE_FOUNTAIN</option>
                <option value="volcano">COM_FDSHOP_META_PRODUCT_TYPE_VOLCANO</option>
                <option value="ground_fireworks">COM_FDSHOP_META_PRODUCT_TYPE_GROUND_FIREWORKS</option>
                <option value="light_fireworks">COM_FDSHOP_META_PRODUCT_TYPE_LIGHT_FIREWORKS</option>
                <option value="sound_generator">COM_FDSHOP_META_PRODUCT_TYPE_SOUND_GENERATOR</option>
                <option value="firebirds">COM_FDSHOP_META_PRODUCT_TYPE_FIREBIRDS</option>
                <option value="roman_candles">COM_FDSHOP_META_PRODUCT_TYPE_ROMAN_CANDLES</option>
                <option value="youth_fireworks">COM_FDSHOP_META_PRODUCT_TYPE_YOUTH_FIREWORKS</option>
                <option value="year_round_fireworks">COM_FDSHOP_META_PRODUCT_TYPE_YEAR_ROUND_FIREWORKS</option>
                <option value="accessories">COM_FDSHOP_META_PRODUCT_TYPE_ACCESSORIES</option>
            </field>

            <field
                name="meta_title"
                type="text"
                label="Meta-Titel"
                size="60"
            />

            <field
                name="meta_description"
                type="textarea"
                label="Meta-Beschreibung"
                rows="4"
                cols="60"
                filter="raw"
            />
        </fieldset>

        <fieldset name="special" label="Besondere Felder">
            <field name="filter_option_ids" type="list" multiple="true" filter="array" label="Zusätzliche Filteroptionen" />
            <field
                name="unit_type"
                type="list"
                label="Einheitstyp"
                default="Stück"
            >
                <option value="Stück">Stück</option>
                <option value="Display">Display</option>
                <option value="Schinken">Schinken</option>
                <option value="VE">VE</option>
            </field>

            <field
                name="unit_quantity"
                type="number"
                label="Einheitsmenge"
                step="1"
                min="1"
            />

            <field name="unit_discount_type" type="list" label="Verpackungsrabatt" default="none">
                <option value="none">Kein Rabatt</option>
                <option value="percent">Prozent</option>
                <option value="amount">Fester Bruttopreis</option>
            </field>

            <field name="unit_discount_value" type="number" label="Rabattwert / Paketpreis" step="0.01" min="0" />

            <field
                name="nem"
                type="number"
                label="NEM"
                step="0.001"
                min="0"
            />

            <field
                name="shot_count"
                type="number"
                label="Schussanzahl"
                step="0.001"
                min="0"
            />

            <field
                name="caliber"
                type="text"
                label="Kaliber"
                size="40"
            />

            <field
                name="burn_time"
                type="text"
                label="Brenndauer"
                size="40"
            />

            <field
                name="rise_height"
                type="text"
                label="Steighöhe"
                size="40"
            />

            <field
                name="ribbon_new"
                type="radio"
                label="Ribbon Neu"
                default="0"
                class="btn-group btn-group-yesno"
            >
                <option value="1">Ja</option>
                <option value="0">Nein</option>
            </field>

            <field
                name="ribbon_hot"
                type="radio"
                label="Ribbon Hot"
                default="0"
                class="btn-group btn-group-yesno"
            >
                <option value="1">Ja</option>
                <option value="0">Nein</option>
            </field>

        </fieldset>

        <fieldset name="dimensions" label="Maße">
            <field
                name="weight"
                type="number"
                label="Gewicht"
                step="0.001"
                min="0"
            />

            <field
                name="length"
                type="number"
                label="Länge"
                step="0.001"
                min="0"
            />

            <field
                name="width"
                type="number"
                label="Breite"
                step="0.001"
                min="0"
            />

            <field
                name="height"
                type="number"
                label="Höhe"
                step="0.001"
                min="0"
            />
        </fieldset>

        <fieldset name="media" label="Medien">
            <field
                name="product_image"
                type="file"
                label="Produktbild"
                accept="image/*"
            />

            <field
                name="video_1"
                type="textarea"
                label="Video 1"
                rows="4"
                filter="raw"
            />

            <field
                name="video_2"
                type="textarea"
                label="Video 2"
                rows="4"
                filter="raw"
            />

            <field
                name="video_3"
                type="textarea"
                label="Video 3"
                rows="4"
                filter="raw"
            />
        </fieldset>
    </fields>
</form>
