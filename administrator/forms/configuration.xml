<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields>
        <fieldset name="basic" label="Konfiguration">
            <field
                name="id"
                type="hidden"
                default="1"
            />

            <field
                name="general_vat_rate"
                type="number"
                label="Allgemeiner MwSt-Satz"
                step="0.01"
                min="0"
                required="true"
            />
			
			<field
                name="general_currency"
                type="currency"
                label="Allgemeiner Währung"
                required="true"
            />



            <field
                name="katalog_active"
                type="radio"
                label="Katalogmodus aktiv"
                description="Aktiviert den globalen Katalogmodus. Ist der Katalogmodus aktiv, werden im Frontend keine Warenkorb-Buttons angezeigt."
                default="0"
                class="btn-group btn-group-yesno"
            >
                <option value="0">Nein</option>
                <option value="1">Ja</option>
            </field>

            <field
                name="image_size_default"
                type="number"
                label="Bildgröße Standard"
                step="1"
                min="1"
                required="true"
            />

            <field name="image_quality_default" type="number" label="Bildqualität Standard (WebP)" step="1" min="1" max="100" required="true" />

            <field
                name="image_size_small"
                type="number"
                label="Bildgröße Klein"
                step="1"
                min="1"
                required="true"
            />

            <field name="image_quality_small" type="number" label="Bildqualität Klein (WebP)" step="1" min="1" max="100" required="true" />

            <field
                name="image_size_mobile"
                type="number"
                label="Bildgröße Mobile"
                step="1"
                min="1"
                required="true"
            />

            <field name="image_quality_mobile" type="number" label="Bildqualität Mobile (WebP)" step="1" min="1" max="100" required="true" />

            <field
                name="image_size_manufacturer"
                type="number"
                label="Bildgröße Hersteller"
                step="1"
                min="1"
                required="true"
            />

            <field
                name="show_terms_checkbox"
                type="radio"
                label="Checkbox für AGB anzeigen"
                default="0"
                class="btn-group btn-group-yesno"
            >
                <option value="1">Ja</option>
                <option value="0">Nein</option>
            </field>

            <field
                name="require_terms_checkbox"
                type="radio"
                label="Checkbox für AGB verpflichtend"
                default="0"
                class="btn-group btn-group-yesno"
            >
                <option value="1">Ja</option>
                <option value="0">Nein</option>
            </field>
        </fieldset>
        <fieldset name="documents_email" label="Dokumente &amp; E-Mail">
            <field name="document_company_name" type="text" label="Firmenname" filter="string" />
            <field name="document_company_street" type="text" label="Straße" filter="string" />
            <field name="document_company_postal_code" type="text" label="PLZ" filter="string" />
            <field name="document_company_city" type="text" label="Ort" filter="string" />
            <field name="document_company_phone" type="text" label="Telefon" filter="string" />
            <field name="document_company_email" type="email" label="E-Mail" />
            <field name="document_company_website" type="url" label="Website" />
            <field name="document_company_logo" type="media" label="Logo" directory="images" preview="tooltip" />
            <field name="document_account_holder" type="text" label="Kontoinhaber" filter="string" />
            <field name="document_bank_name" type="text" label="Bankname" filter="string" />
            <field name="document_iban" type="text" label="IBAN" filter="string" />
            <field name="document_bic" type="text" label="BIC/SWIFT" filter="string" />
            <field name="document_footer_text" type="textarea" label="Zusätzliche Fußzeile" filter="safehtml" rows="3" />
            <field name="document_payment_days" type="number" label="Zahlungsziel Überweisung (Tage)" default="7" min="1" max="365" />
            <field name="document_special_category_id" type="sql" label="Sonderkategorie Sammlung 2" query="SELECT id AS value, category_name AS text FROM #__fdshop_categories WHERE is_active = 1 ORDER BY category_name" key_field="value" value_field="text" translate="false"><option value="0">- Keine Sonderkategorie -</option></field>
            <field name="document_collection_one_title" type="text" label="Titel Sammlung 1" default="Sammlung: Batterien, Raketen, Single Shots etc." filter="string" />
            <field name="document_collection_two_title" type="text" label="Titel Sammlung 2" default="Sammlung: Verbünde" filter="string" />
        </fieldset>
    </fields>
</form>
