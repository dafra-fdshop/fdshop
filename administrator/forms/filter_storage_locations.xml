<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="Suche"
            description="Suche nach Name, Code oder Beschreibung; id:123 sucht nach ID"
            hint="Lagerorte durchsuchen"
        />

        <field
            name="published"
            type="list"
            label="Aktivstatus"
            class="js-select-submit-on-change"
        >
            <option value="">Aktivstatus auswählen</option>
            <option value="1">Aktiv</option>
            <option value="0">Inaktiv</option>
        </field>
    </fields>

    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="a.ordering ASC"
            class="js-select-submit-on-change"
        >
            <option value="a.ordering ASC">Reihenfolge ASC</option>
            <option value="a.ordering DESC">Reihenfolge DESC</option>
            <option value="a.location_name ASC">Name ASC</option>
            <option value="a.location_name DESC">Name DESC</option>
            <option value="a.code ASC">Code ASC</option>
            <option value="a.code DESC">Code DESC</option>
            <option value="a.is_active ASC">Aktivstatus ASC</option>
            <option value="a.is_active DESC">Aktivstatus DESC</option>
            <option value="a.id ASC">ID ASC</option>
            <option value="a.id DESC">ID DESC</option>
        </field>

        <field
            name="limit"
            type="limitbox"
            default="20"
            class="js-select-submit-on-change"
        />
    </fields>
</form>
