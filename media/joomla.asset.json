{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "com_fdshop",
  "version": "0.0.51",
  "assets": [
    {
      "name": "com_fdshop.site",
      "type": "style",
      "uri": "com_fdshop/site.css"
    },
    {
      "name": "com_fdshop.site",
      "type": "script",
      "uri": "com_fdshop/site.js",
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "com_fdshop.cart",
      "type": "script",
      "uri": "com_fdshop/cart.js",
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "com_fdshop.purchase",
      "type": "script",
      "uri": "com_fdshop/purchase.js",
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "com_fdshop.products-module",
      "type": "script",
      "uri": "com_fdshop/products-module.js",
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.bundle",
      "type": "style",
      "uri": "com_fdshop/bundle.css"
    },
    {
      "name": "com_fdshop.bundle",
      "type": "script",
      "uri": "com_fdshop/bundle.js",
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.search",
      "type": "script",
      "uri": "com_fdshop/search.js",
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.favorite-state",
      "type": "script",
      "uri": "com_fdshop/favorite-state.js",
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.favorites",
      "type": "script",
      "uri": "com_fdshop/favorites.js",
      "dependencies": ["com_fdshop.favorite-state"],
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.comparison-state",
      "type": "script",
      "uri": "com_fdshop/comparison-state.js",
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.comparison",
      "type": "script",
      "uri": "com_fdshop/comparison.js",
      "dependencies": ["com_fdshop.comparison-state"],
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.admin-product",
      "type": "script",
      "uri": "com_fdshop/admin-product.js",
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.admin-bundle",
      "type": "script",
      "uri": "com_fdshop/admin-bundle.js",
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "com_fdshop.admin-master-import",
      "type": "script",
      "uri": "com_fdshop/admin-master-import.js",
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.admin-paymentmethod",
      "type": "script",
      "uri": "com_fdshop/admin-paymentmethod.js",
      "attributes": { "defer": true }
    },
    {
      "name": "com_fdshop.admin-order",
      "type": "script",
      "uri": "com_fdshop/admin-order.js",
      "attributes": { "defer": true }
    }
  ]
}
